[Unit]
Description=OpenRGB SDK server (for seele-rgb)
After=systemd-udev-settle.service
Wants=systemd-udev-settle.service

[Service]
User={USER}
SupplementaryGroups=i2c plugdev
ExecStart={OPENRGB} --server --server-host 127.0.0.1 --server-port 6742
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
